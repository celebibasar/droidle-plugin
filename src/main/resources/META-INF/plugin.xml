<idea-plugin>
    <id>app.droidle.plugin</id>
    <name>Droidle — Daily Android Quiz</name>
    <vendor email="basarcelebi02@gmail.com" url="https://droidle.vercel.app">Droidle</vendor>

    <description><![CDATA[
        <p><b>Start your Android dev day with a 5-question quiz — right inside Android Studio.</b></p>
        <p>Droidle opens droidle.vercel.app in a sidebar panel so you can answer today's 5 Android questions without leaving the IDE.</p>
        <p>Topics: Jetpack Compose, Coroutines, Architecture, Android Internals, AI Prompting.</p>
        <p>A daily reminder balloon appears when you open your project — never miss a day.</p>
    ]]></description>

    <change-notes><![CDATA[
        <ul><li>0.1.0 — Initial release</li></ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool Window -->
        <toolWindow
            id="Droidle"
            anchor="right"
            factoryClass="app.droidle.plugin.DroidleToolWindowFactory"
            secondary="false"
            canCloseContents="false"
            icon="/icons/droidle.svg"
        />

        <!-- Settings -->
        <applicationConfigurable
            parentId="tools"
            instance="app.droidle.plugin.settings.DroidleSettingsConfigurable"
            id="app.droidle.plugin.settings"
            displayName="Droidle"
        />

        <!-- Services -->
        <applicationService serviceImplementation="app.droidle.plugin.state.StateManager"/>
        <applicationService serviceImplementation="app.droidle.plugin.service.DroidleService"/>
        <applicationService serviceImplementation="app.droidle.plugin.settings.DroidleSettingsState"/>

        <!-- Günlük açılış bildirimi -->
        <notificationGroup
            id="Droidle"
            displayType="BALLOON"
            isLogByDefault="false"
        />

        <!-- Startup: her proje açılışında çalışır -->
        <postStartupActivity implementation="app.droidle.plugin.DroidleStartupActivity"/>

    </extensions>
</idea-plugin>
